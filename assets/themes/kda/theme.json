    "foreground_motion_px": [1, 1],
    "display_stage_frame": false,
    "content_rendering": "live_native_widgets",
    "input_geometry_follows_visuals": true
  },
  "palette": {
    "bg": "#09090b",
    "surface": "#18181b",
    "raised": "#222225",
    "border": "#373740",
    "text": "#edeef4",
