    "card_ms": 300,
    "silk_reveal_ms": 650,
    "pointer_response_ms": 280,
    "control_response_ms": 180,
    "hud_action_ms": 220,
    "hud_shell_ms": 300,
    "looping": false,
    "edge_flow": {
      "style": "localized_kda_edge_reflection",
