      "covers_text": false,
      "geometry_animated": false,
      "pause_when_hidden_or_minimized": true,
      "respect_reduced_motion": true
    },
    "data_delay_ms": 0,
    "reduced_motion_preference": "appearance/reducedMotion",
    "respect_windows_animations": true
