    "silver": "#dce0eb",
    "ice": "#bedee9",
    "lilac": "#b6a8d2",
    "ready": "#98caba",
    "danger": "#e19aa9",
    "gold": "#d8c59c"
  },
  "typography": {
    "body": [
      "Inter",
      "Noto Sans SC",
      "Segoe UI"
    ],
    "numeric": [
      "Inter",
      "Noto Sans SC"
    ],
    "display": [
      "Inter",
      "Noto Sans SC"
    ],
    "body_weight": 400,
    "bundled_weights": [
      400,
      500,
      600,
      700
    ],
    "license": "SIL OFL 1.1"
  },
  "shape": {
    "window": 8,
    "workspace": 4,
